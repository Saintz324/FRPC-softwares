# Anthropic API key — required for the chat widget
# Get your key at https://console.anthropic.com
ANTHROPIC_API_KEY=your-api-key-here

# Resend API key — required for email sending (leads & proposals)
# Get your key at https://resend.com
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Override destination email (optional, defaults to it@frpc.pt)
# LEAD_EMAIL=it@frpc.pt
